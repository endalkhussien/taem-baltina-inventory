# Replace with your Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taem_baltina_dev

# Optional: tune serverless Postgres pool size (default 3)
PG_POOL_MAX=3

# Bootstrap the first admin account (used only when no admin exists in the database)
ADMIN_USER=admin
ADMIN_PASS=password

# Session signing secret
JWT_SECRET=change-me

# Recovery secret for forgot-password / first-time account setup
PASSWORD_RESET_SECRET=choose-a-long-random-recovery-secret
